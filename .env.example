# Use Supabase Storage for persistent uploads (recommended for deployment).
IMAGE_STORAGE_BACKEND=supabase
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

# Gmail password reset email (use a Google App Password, not your account password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Frontend page that accepts ?token=... and submits it to /api/v1/auths/reset-password
PASSWORD_RESET_URL=

# Used only when IMAGE_STORAGE_BACKEND=local. Render's local disk is ephemeral.
# UPLOAD_DIR=uploads
